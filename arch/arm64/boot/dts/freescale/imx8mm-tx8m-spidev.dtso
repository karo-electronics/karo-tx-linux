/dts-v1/;

/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include "imx8mm-pinfunc.h"

&{/chosen} {
	overlays {
		tx8m-spidev;
	};
};

&ecspi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2 &pinctrl_ecspi2_cs0 &pinctrl_ecspi2_cs1>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW &gpio4 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		reg = <0>;
		compatible = "karo,spidev-test";
	};

	spidev@1 {
		reg = <1>;
		compatible = "karo,spidev-test";
	};
};

&iomuxc {
	pinctrl_ecspi2: ecspi2grp {
		fsl,pins = <
			MX8MM_IOMUXC_ECSPI2_SCLK_ECSPI2_SCLK	0x156
			MX8MM_IOMUXC_ECSPI2_MOSI_ECSPI2_MOSI	0x156
			MX8MM_IOMUXC_ECSPI2_MISO_ECSPI2_MISO	0x156
		>;
	};

	pinctrl_ecspi2_cs0: ecspi2-cs0grp {
		fsl,pins = <
			MX8MM_IOMUXC_ECSPI2_SS0_GPIO5_IO13	0x3fe
		>;
	};

	pinctrl_ecspi2_cs1: ecspi2-cs1grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD2_WP_GPIO2_IO20		0x3fe
		>;
	};
};
