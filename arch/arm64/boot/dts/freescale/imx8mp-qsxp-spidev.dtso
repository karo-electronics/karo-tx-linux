/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include "imx8mp-pinfunc.h"

&{/} {
	aliases {
		spi0 = "/soc@0/bus@30800000/spba-bus@30800000/spi@30830000";
		spi1 = "/soc@0/bus@30800000/spba-bus@30800000/spi@30820000";
	};

	chosen {
		overlays {
			qsxp-spidev;
		};
	};
};

&ecspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi1 &pinctrl_ecspi1_cs>;
	cs-gpios = <&gpio5 9 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		reg = <0>;
		compatible = "karo,spidev-test";
	};
};

&ecspi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2 &pinctrl_ecspi2_cs>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		reg = <0>;
		compatible = "karo,spidev-test";
	};
};

&iomuxc {
	pinctrl_ecspi1: ecspi1grp {
		fsl,pins = <
			MX8MP_IOMUXC_ECSPI1_MISO__ECSPI1_MISO		0x156
			MX8MP_IOMUXC_ECSPI1_MOSI__ECSPI1_MOSI		0x156
			MX8MP_IOMUXC_ECSPI1_SCLK__ECSPI1_SCLK		0x156
		>;
	};

	pinctrl_ecspi1_cs: ecspi1-csgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ECSPI1_SS0__GPIO5_IO09		0x156
		>;
	};

	pinctrl_ecspi2: ecspi2grp {
		fsl,pins = <
			MX8MP_IOMUXC_ECSPI2_MISO__ECSPI2_MISO		0x156
			MX8MP_IOMUXC_ECSPI2_MOSI__ECSPI2_MOSI		0x156
			MX8MP_IOMUXC_ECSPI2_SCLK__ECSPI2_SCLK		0x156
		>;
	};

	pinctrl_ecspi2_cs: ecspi2-csgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ECSPI2_SS0__GPIO5_IO13		0x156
		>;
	};
};
