 *
 * EDT ETM0700G0DH6 800x480 RGB panel on the MB7 LCD connector.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "imx6ull-pinfunc-snvs.h"

&{/} {
	chosen {
		overlays {
			karo-panel-etm0700;
		};
	};
};

&lcdif {
	status = "okay";
};

&backlight {
	status = "okay";
};

&pwm5 {
	status = "okay";
};

&lcd_panel {
	compatible = "panel-dpi";
	data-mapping = "rgb24";
	width-mm = <152>;
	height-mm = <91>;
	status = "okay";

	panel-timing {
		clock-frequency = <33264000>;
		hactive = <800>;
		vactive = <480>;
		hback-porch = <88>;
		hsync-len = <128>;
		hfront-porch = <40>;
		vback-porch = <33>;
		vsync-len = <2>;
		vfront-porch = <10>;
		hsync-active = <0>;
		vsync-active = <0>;
		de-active = <1>;
		pixelclk-active = <0>;
	};
};

/* FT5x06 touch on the MB7 panel connector */
&i2c2 {
	polytouch: polytouch@38 {
		compatible = "edt,edt-ft5x06";
		reg = <0x38>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_polytouch_snvs>;
		interrupt-parent = <&gpio5>;
		interrupts = <2 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio5 3 GPIO_ACTIVE_LOW>;
		wake-gpios = <&gpio5 8 GPIO_ACTIVE_HIGH>;
		wakeup-source;
	};
};

&iomuxc_snvs {
	pinctrl_polytouch_snvs: edt-ft5x06grp {
		fsl,pins = <
			MX6ULL_PAD_SNVS_TAMPER2__GPIO5_IO02	0x1b0b0
			MX6ULL_PAD_SNVS_TAMPER3__GPIO5_IO03	0x1b0b0
			MX6ULL_PAD_SNVS_TAMPER8__GPIO5_IO08	0x1b0b0
		>;
	};
};
